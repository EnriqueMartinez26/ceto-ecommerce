<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Exact patch, never "latest" (D-20261006-08). Verified against Maven Central: 4.1.1. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>ar.cetobhb</groupId>
    <artifactId>ceto-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ceto-backend</name>
    <description>Ceto BHB backend</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Windows JVMs may report the legacy zone id America/Buenos_Aires, which Postgres 16 rejects as a
             session TimeZone. Tests run in UTC (the app stores timestamptz/UTC anyway).
             IDE runs and `java -jar` on this Windows machine need the same VM option (-Duser.timezone=UTC).
             Production must pin the JVM to UTC too; that belongs to the Docker/compose change, not done here. -->
        <argLine>-Duser.timezone=UTC</argLine>
        <!-- Not managed by the Boot BOM, so pinned explicitly. 1.5.1 verified on Maven Central (docs/dependencias.md). -->
        <archunit.version>1.5.1</archunit.version>
        <!-- Not managed by the Boot BOM. 9.0.40 verified on Maven Central (docs/dependencias.md, G0). -->
        <libphonenumber.version>9.0.40</libphonenumber.version>
        <!-- Build-only, used by the `mutation` profile. Verified on Maven Central (docs/dependencias.md, pending review). -->
        <pitest-maven.version>1.30.0</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Boot 4: Flyway auto-configuration needs the explicit starter, plain flyway-core is not enough. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Boot-managed. Needed for @Validated @ConfigurationProperties (OrderProperties, fail-closed config). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
            <version>${libphonenumber.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x: non-generic org.testcontainers.postgresql.PostgreSQLContainer; version from the Boot BOM. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Zero compiler warnings as baseline (CLAUDE.md section 10). -->
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- *Test = unit (surefire, no DB); *IT = integration on a real Postgres container (failsafe). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Mutation testing with PIT (manual, NOT part of `./mvnw clean verify`). See docs/testing.md.
            Run: ./mvnw -Pmutation test-compile \
                     org.pitest:pitest-maven:mutationCoverage@domain \
                     org.pitest:pitest-maven:mutationCoverage@services
            Plugin versions are verified in docs/dependencias.md ("Mutation testing", pending Mateo's review).
            Build-only: nothing here reaches the runtime classpath.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <reportsDirectory>${project.build.directory}/pit-reports</reportsDirectory>
                            <jvmArgs>
                                <jvmArg>-Duser.timezone=UTC</jvmArg>
                            </jvmArgs>
                            <!-- Same bar as the compiler baseline: fail loudly rather than skip silently. -->
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                        <executions>
                            <!-- Pure domain rules, covered by fast unit tests (*Test, no Spring, no database). -->
                            <execution>
                                <id>domain</id>
                                <configuration>
                                    <targetClasses>
                                        <param>ar.cetobhb.catalog.domain.*</param>
                                        <param>ar.cetobhb.inventory.domain.*</param>
                                        <param>ar.cetobhb.orders.domain.*</param>
                                        <param>ar.cetobhb.common.domain.*</param>
                                    </targetClasses>
                                    <targetTests>
                                        <param>ar.cetobhb.*Test</param>
                                    </targetTests>
                                    <threads>4</threads>
                                    <reportsDirectory>${project.build.directory}/pit-reports/domain</reportsDirectory>
                                </configuration>
                            </execution>
                            <!-- Critical services, covered by the ITs (real Postgres via Testcontainers; each PIT JVM
                                 starts its own container, so keep threads low). -->
                            <execution>
                                <id>services</id>
                                <configuration>
                                    <targetClasses>
                                        <param>ar.cetobhb.inventory.service.InventoryService</param>
                                        <param>ar.cetobhb.catalog.service.CatalogService</param>
                                        <param>ar.cetobhb.orders.service.*</param>
                                    </targetClasses>
                                    <targetTests>
                                        <param>ar.cetobhb.*</param>
                                    </targetTests>
                                    <threads>2</threads>
                                    <timeoutConstant>20000</timeoutConstant>
                                    <reportsDirectory>${project.build.directory}/pit-reports/services</reportsDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
